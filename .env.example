# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Used by src/utils/supabaseAdmin.ts (server-side only, never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides for src/services/episodesSync.ts
# (code falls back to built-in defaults if unset)
YOUTUBE_PLAYLIST_ID=
SPOTIFY_SHOW_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Shared secret for src/app/api/sync-episodes/route.ts
# (also configured as the CRON_SECRET secret in .github/workflows/sync-episodes.yml)
CRON_SECRET=
